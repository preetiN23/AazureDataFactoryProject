					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-25.centralindia.logic.azure.com:443/workflows/d201f0d5719142b19556bbefcbeeb71c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=SBWLhFHpiaEk3KV0DNlJMA0JS_dZr2zjmSyBJdFv-SM",
					"body": {
						"value": "{\n    \"Status\" : \"Failed\"\n    \"PipeLineName\" : \"@{pipeline().Pipeline}\",                   \n    \"ErrorMsg\" : \"@{activity('Execute Pipeline_Clintrial_Master').Error?.Message}\"\n}",
